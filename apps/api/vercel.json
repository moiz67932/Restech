{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }],
  "functions": {
    "api/index.ts": {
      "maxDuration": 30,
      "includeFiles": [
        "dist/**",
        "../../packages/*/package.json",
        "../../packages/*/dist/**",
        "../../packages/connectors/*/package.json",
        "../../packages/connectors/*/dist/**"
      ]
    }
  }
}
