{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }],
  "functions": {
    "api/index.mjs": {
      "maxDuration": 30,
      "includeFiles": "{dist/**,../../packages/**/{package.json,dist/**}}"
    }
  },
  "crons": [
    {
      "path": "/api/internal/jobs/dispatch-pos-events",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/internal/jobs/reconcile-payment-sessions",
      "schedule": "*/5 * * * *"
    }
  ]
}
