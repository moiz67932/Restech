{
  "name": "restec-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/connectors/*"
  ],
  "scripts": {
    "predev": "npm run build:api",
    "dev": "npm run dev --workspace @restec/api",
    "build": "npm run build --workspaces --if-present",
    "build:api": "tsc -b --force apps/api/tsconfig.json",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretest": "npm run build:api",
    "test": "node --import tsx --test \"packages/**/*.test.ts\" \"apps/**/*.test.ts\" \"scripts/**/*.test.ts\"",
    "test:leakage": "node --import tsx scripts/check-public-content.ts",
    "verify:public-leakage": "npm run test:leakage",
    "validate:openapi": "node --import tsx scripts/validate-openapi.ts",
    "verify:openapi": "npm run validate:openapi",
    "validate:public-artifacts": "node --import tsx scripts/validate-public-artifacts.ts",
    "test:examples:node": "node --check examples/node/restec-client.mjs && node --check examples/node/examples.mjs && node examples/node/examples.mjs --self-test",
    "test:examples": "npm run test:examples:node",
    "check:migrations": "node --import tsx scripts/check-migrations.ts",
    "create:connector": "node --import tsx scripts/create-connector.ts",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:lint": "supabase db lint --local",
    "db:types": "supabase gen types typescript --local --schema public > packages/database/src/database.types.ts",
    "test:database": "node --import tsx --test packages/database/src/*.integration.test.ts",
    "test:e2e:sandbox": "node --import tsx --test apps/api/src/*.e2e.test.ts",
    "test:integration": "node --import tsx --test packages/paely-client/src/mock-server.test.ts apps/api/src/mock.e2e.test.ts",
    "test:e2e:mock": "node --import tsx --test apps/api/src/mock.e2e.test.ts packages/connectors/canonical-rest/src/mock-pos-server.test.ts packages/paely-client/src/mock-server.test.ts",
    "test:remote-sandbox": "node --import tsx --test apps/api/src/sandbox.e2e.test.ts packages/database/src/supabase-repository.integration.test.ts",
    "create:sandbox-credentials": "node --env-file-if-exists=.env --import tsx scripts/create-sandbox-credentials.ts",
    "provision:pos-partner": "node --env-file-if-exists=.env --import tsx scripts/provision-pos-partner.ts",
    "certify:paely-sandbox": "node --import tsx scripts/certify-paely-sandbox.ts",
    "certify:real-payment-session": "node --env-file-if-exists=.env --import tsx scripts/certify-real-payment-session.ts",
    "certify:pos-partner:cron": "node --env-file-if-exists=.env --import tsx scripts/certify-pos-partner-cron.ts",
    "configure:sandbox-mock-pos": "node --env-file-if-exists=.env --import tsx scripts/configure-sandbox-mock-pos.ts",
    "create:demo-bill": "node --import tsx scripts/sandbox-operation.ts create-bill",
    "dispatch:pos-events": "node --import tsx scripts/sandbox-operation.ts dispatch",
    "reconcile:sandbox": "node --import tsx scripts/sandbox-operation.ts reconcile",
    "verify:erasable-syntax": "tsc -p tsconfig.erasable.json",
    "verify:vercel-runtime": "node scripts/verify-vercel-runtime.mjs",
    "verify:vercel-output": "node scripts/smoke-vercel-output.mjs",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run test:e2e:mock && npm run validate:openapi && npm run validate:public-artifacts && npm run test:leakage && npm run test:examples && npm run check:migrations && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "supabase": "^2.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "yaml": "^2.6.0"
  }
}
