{
  "info": {
    "name": "Restec POS Partner v1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Signed Restec POS sandbox requests. Never store real secrets in the collection."
  },
  "variable": [
    { "key": "base_url", "value": "https://sandbox-api.restec.example" },
    { "key": "api_key", "value": "rst_test_replace" },
    { "key": "request_signing_secret", "value": "replace" },
    { "key": "webhook_signing_secret", "value": "replace" },
    { "key": "location_id", "value": "loc_example" },
    { "key": "external_bill_id", "value": "INV-1001" },
    { "key": "payment_session_id", "value": "rps_test_replace" },
    { "key": "environment", "value": "sandbox" }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const timestamp = Math.floor(Date.now()/1000).toString();",
          "const requestId = 'req_' + pm.variables.replaceIn('{{$guid}}').replaceAll('-', '');",
          "const resolvedUrl = new URL(pm.variables.replaceIn(pm.request.url.toString()));",
          "const path = resolvedUrl.pathname;",
          "const rawBody = pm.request.body && pm.request.body.mode === 'raw' ? pm.variables.replaceIn(pm.request.body.raw) : '';",
          "const input = timestamp + '.' + pm.request.method.toUpperCase() + '.' + path + '.' + rawBody;",
          "const signature = CryptoJS.HmacSHA256(input, pm.variables.get('request_signing_secret')).toString(CryptoJS.enc.Hex);",
          "pm.variables.set('timestamp', timestamp); pm.variables.set('request_id', requestId); pm.variables.set('signature', 'v1=' + signature);"
        ]
      }
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{api_key}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Health",
      "request": { "auth": { "type": "noauth" }, "method": "GET", "url": "{{base_url}}/health" }
    },
    {
      "name": "Create or update bill",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Restec-Timestamp", "value": "{{timestamp}}" },
          { "key": "X-Restec-Signature", "value": "{{signature}}" },
          { "key": "X-Request-Id", "value": "{{request_id}}" },
          { "key": "Idempotency-Key", "value": "bill-{{external_bill_id}}-v1" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"external_table_id\":\"12\",\"version\":1,\"currency\":\"PKR\",\"status\":\"open\",\"order_status\":\"accepted\",\"items\":[{\"external_item_id\":\"I1\",\"name\":\"Meal\",\"quantity\":1,\"unit_amount\":10000,\"total_amount\":10000}],\"totals\":{\"subtotal\":10000,\"tax\":0,\"service_charge\":0,\"discount\":0,\"tip\":0,\"grand_total\":10000},\"occurred_at\":\"2026-07-18T10:30:00Z\",\"metadata\":{}}"
        },
        "url": "{{base_url}}/v1/locations/{{location_id}}/bills/{{external_bill_id}}"
      }
    },
    {
      "name": "Retrieve bill",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Restec-Timestamp", "value": "{{timestamp}}" },
          { "key": "X-Restec-Signature", "value": "{{signature}}" },
          { "key": "X-Request-Id", "value": "{{request_id}}" }
        ],
        "url": "{{base_url}}/v1/locations/{{location_id}}/bills/{{external_bill_id}}"
      }
    },
    {
      "name": "Record external payment",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Restec-Timestamp", "value": "{{timestamp}}" },
          { "key": "X-Restec-Signature", "value": "{{signature}}" },
          { "key": "X-Request-Id", "value": "{{request_id}}" },
          { "key": "Idempotency-Key", "value": "payment-POSPAY-1001" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"external_payment_id\":\"POSPAY-1001\",\"method\":\"card_terminal\",\"amount\":10000,\"currency\":\"PKR\",\"status\":\"completed\",\"occurred_at\":\"2026-07-18T10:45:00Z\",\"metadata\":{}}"
        },
        "url": "{{base_url}}/v1/locations/{{location_id}}/bills/{{external_bill_id}}/external-payments"
      }
    },
    {
      "name": "List tables",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Restec-Timestamp", "value": "{{timestamp}}" },
          { "key": "X-Restec-Signature", "value": "{{signature}}" },
          { "key": "X-Request-Id", "value": "{{request_id}}" }
        ],
        "url": "{{base_url}}/v1/locations/{{location_id}}/tables"
      }
    },
    {
      "name": "Create hosted payment session",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) pm.collectionVariables.set('payment_session_id', pm.response.json().payment_session_id);",
              "pm.test('Initial state requires customer action', () => pm.expect(pm.response.json().status).to.eql('requires_customer_action'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Restec-Environment", "value": "{{environment}}" },
          { "key": "X-Restec-Timestamp", "value": "{{timestamp}}" },
          { "key": "X-Restec-Signature", "value": "{{signature}}" },
          { "key": "X-Request-Id", "value": "{{request_id}}" },
          { "key": "Idempotency-Key", "value": "hosted-payment-{{external_bill_id}}-1" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"amount_minor\":10000,\"currency\":\"PKR\",\"method\":\"card\",\"customer\":{\"email\":\"sandbox@example.com\",\"mobile\":\"03000000000\"}}"
        },
        "url": "{{base_url}}/v1/locations/{{location_id}}/bills/{{external_bill_id}}/payment-sessions",
        "description": "Open only the returned Restec checkout_url. Card data is entered on the secure hosted payment page and payment completion is asynchronous."
      }
    },
    {
      "name": "Get hosted payment session",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Restec-Environment", "value": "{{environment}}" },
          { "key": "X-Restec-Timestamp", "value": "{{timestamp}}" },
          { "key": "X-Restec-Signature", "value": "{{signature}}" },
          { "key": "X-Request-Id", "value": "{{request_id}}" }
        ],
        "url": "{{base_url}}/v1/locations/{{location_id}}/payment-sessions/{{payment_session_id}}"
      }
    }
  ]
}
