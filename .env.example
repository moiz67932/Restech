# Environment: sandbox, production, or test
RESTEC_ENV=sandbox
RESTEC_REPOSITORY_DRIVER=supabase
RESTEC_PUBLIC_BASE_URL=https://sandbox-api.restec.io
RESTEC_DATABASE_URL=postgresql://user:password@host:5432/database
SUPABASE_URL=https://example.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-in-secret-manager
PAELY_PRIVATE_BASE_URL=https://private.example.invalid
PAELY_SERVICE_ID=replace-in-secret-manager
PAELY_PRIVATE_BEARER_TOKEN=replace-in-secret-manager
PAELY_PRIVATE_SIGNING_SECRET=replace-in-secret-manager
PAELY_EVENT_SIGNING_SECRET=replace-in-secret-manager
RESTEC_API_KEY_HASH_SECRET=replace-with-32-byte-secret
RESTEC_SECRET_ENCRYPTION_KEY=replace-with-base64-32-byte-key
RESTEC_WEBHOOK_MASTER_KEY=replace-with-base64-32-byte-key
RESTEC_TIMESTAMP_TOLERANCE_SECONDS=300
RESTEC_PRIVATE_REQUEST_TIMEOUT_MS=5000
RESTEC_POS_DELIVERY_TIMEOUT_MS=5000
RESTEC_MAX_DELIVERY_ATTEMPTS=10
RESTEC_DISPATCH_BATCH_SIZE=25
RESTEC_INTERNAL_JOB_TOKEN=replace-in-secret-manager
RESTEC_STRICT_RATE_LIMITING=false
CRON_SECRET=replace-in-secret-manager
RUN_REAL_PAELY_SANDBOX_CERTIFICATION=false
PORTAL_AUTH_REDIRECT_URL=https://portal.restec.io/auth/callback
DOCS_PUBLIC_BASE_URL=https://docs.restec.io
